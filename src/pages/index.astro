---
import { existsSync, readFileSync } from "node:fs";
import Header from "../components/Header.astro";
import "../styles/global.css";

const latest = JSON.parse(readFileSync("data/latest.json", "utf8"));
const daily = JSON.parse(readFileSync("data/daily.json", "utf8"));
const monthly = JSON.parse(readFileSync("data/monthly.json", "utf8"));
const nldc = existsSync("data/nldc-latest.json")
  ? JSON.parse(readFileSync("data/nldc-latest.json", "utf8"))
  : null;

const current = latest.current;
const days = (daily.days ?? []).slice(-8);
const last7 = days.slice(-7);
const months = monthly.months ?? [];
const last12 = months.slice(-12);

const FUELS = [
  { key: "gas", label: "Gas" },
  { key: "liquid_fuel", label: "Liquid fuel" },
  { key: "coal", label: "Coal" },
  { key: "hydro", label: "Hydro" },
  { key: "solar", label: "Solar" },
  { key: "wind", label: "Wind" },
] as const;

const CORRIDORS = [
  { key: "bheramara", label: "Bheramara" },
  { key: "tripura", label: "Tripura" },
  { key: "adani", label: "Adani" },
  { key: "nepal", label: "Nepal" },
] as const;

function importsOf(row: Record<string, number>) {
  return (
    Number(row.bheramara || 0) +
    Number(row.tripura || 0) +
    Number(row.adani || 0) +
    Number(row.nepal || 0)
  );
}

function slimRow(row: Record<string, number | string>) {
  return {
    generation_mw: Number(row.generation_mw || 0),
    gas: Number(row.gas || 0),
    liquid_fuel: Number(row.liquid_fuel || 0),
    coal: Number(row.coal || 0),
    hydro: Number(row.hydro || 0),
    solar: Number(row.solar || 0),
    wind: Number(row.wind || 0),
    bheramara: Number(row.bheramara || 0),
    tripura: Number(row.tripura || 0),
    adani: Number(row.adani || 0),
    nepal: Number(row.nepal || 0),
  };
}

function fmtMw(n: number) {
  return Math.round(n).toLocaleString("en-US");
}

function fmtWhen(iso: string) {
  const d = new Date(iso);
  return new Intl.DateTimeFormat("en-GB", {
    timeZone: "Asia/Dhaka",
    day: "numeric",
    month: "short",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
  }).format(d);
}

function fmtDate(iso: string) {
  const [y, m, d] = iso.split("-").map(Number);
  const dt = new Date(Date.UTC(y, m - 1, d));
  return new Intl.DateTimeFormat("en-GB", {
    timeZone: "UTC",
    day: "numeric",
    month: "short",
    year: "numeric",
  }).format(dt);
}

function fmtGwh(n: number) {
  const digits = Math.abs(n) >= 10 ? 1 : 2;
  return n.toLocaleString("en-US", {
    minimumFractionDigits: digits,
    maximumFractionDigits: digits,
  });
}

function addDays(iso: string, days: number) {
  const [y, m, d] = iso.split("-").map(Number);
  const dt = new Date(Date.UTC(y, m - 1, d + days));
  return dt.toISOString().slice(0, 10);
}

const todayDhaka = new Intl.DateTimeFormat("en-CA", {
  timeZone: "Asia/Dhaka",
}).format(new Date());
const nldcCurrent = nldc?.current ?? null;
const nldcIsYesterday =
  nldcCurrent && nldcCurrent.date === addDays(todayDhaka, -1);

const mix = [
  ...FUELS.map((f) => ({
    ...f,
    mw: Number(current[f.key] || 0),
  })),
  { key: "imports", label: "Imports", mw: importsOf(current) },
];
const mixTotal = mix.reduce((s, x) => s + x.mw, 0) || 1;
const firstMonth = months[0]?.month ?? "";
const lastMonth = months[months.length - 1]?.month ?? "";
const rangeLabel = firstMonth && lastMonth ? `${firstMonth} – ${lastMonth}` : "";
const defaultRange =
  last12.length >= 2
    ? `${last12[0].month} – ${last12[last12.length - 1].month}`
    : rangeLabel;

const chartData = {
  current: {
    ...slimRow(current),
    datetime: String(current.datetime),
    remark: String(current.remark || ""),
  },
  hourly: (latest.hourly ?? []).map((h: Record<string, number | string>) => ({
    ...slimRow(h),
    datetime: String(h.datetime),
    remark: String(h.remark || ""),
  })),
  last7: last7.map((d: Record<string, number | string>) => ({
    ...slimRow(d),
    date: String(d.date),
  })),
  prevDay:
    days.length > 7
      ? { ...slimRow(days[0]), date: String(days[0].date) }
      : null,
  months: months.map((d: Record<string, number | string>) => ({
    ...slimRow(d),
    month: String(d.month),
  })),
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Bangladesh Grid</title>
    <meta
      name="description"
      content="Unofficial dashboard of hourly electricity generation on the Bangladesh grid, from Power Grid Bangladesh PLC public data."
    />
  </head>
  <body>
    <Header current="generation">
      <p class="lede">
        Hourly generation dispatched on the national grid, compiled from the
        public Power Grid Bangladesh PLC table. This is not an official site.
      </p>
    </Header>

    <main>
      <section class="hero" aria-labelledby="now-label">
        <p id="now-label" class="kicker">Latest generation</p>
        <p class="mw">
          <span class="mw-num">{fmtMw(current.generation_mw)}</span>
          <span class="mw-unit">MW</span>
        </p>
        <p class="when">
          {fmtWhen(current.datetime)} Bangladesh time
          {current.remark ? ` · ${current.remark}` : ""}
        </p>

        <div
          class="mixbar"
          role="group"
          aria-label="Fuel mix of the latest snapshot. Click a band to isolate that fuel on the charts."
        >
          {
            mix.map((item) => (
              <button
                type="button"
                class={`seg seg-${item.key}`}
                style={`width:${(item.mw / mixTotal) * 100}%`}
                data-fuel={item.key}
                title={`Isolate ${item.label} on the charts`}
                aria-label={`${item.label}: ${fmtMw(item.mw)} MW. Isolate on the charts.`}
              />
            ))
          }
        </div>
        <div class="fuel-filters">
          <p class="kicker" id="fuel-filter-label">Isolate a fuel</p>
          <ul
            class="legend"
            id="fuel-legend"
            aria-labelledby="fuel-filter-label"
          >
            <li>
              <button
                type="button"
                data-fuel="all"
                aria-pressed="true"
                title="Show all fuels on the charts"
              >
                All fuels
              </button>
            </li>
            {
              mix.map((item) => (
                <li>
                  <button
                    type="button"
                    data-fuel={item.key}
                    aria-pressed="false"
                    title={`Isolate ${item.label} on the charts`}
                  >
                    <span
                      class={`fuel-swatch seg-${item.key}`}
                      aria-hidden="true"
                    ></span>
                    <span class="fuel-copy">
                      {item.label}
                      <span class="muted">{fmtMw(item.mw)} MW</span>
                    </span>
                  </button>
                </li>
              ))
            }
          </ul>
          <div class="corridor-block" id="corridor-legend" hidden>
            <p class="kicker">Import corridors</p>
            <ul class="legend" aria-label="Import corridors">
              {
                CORRIDORS.map((item) => (
                  <li>
                    <button
                      type="button"
                      data-fuel={item.key}
                      aria-pressed="false"
                      title={`Isolate ${item.label} on the charts`}
                    >
                      <span
                        class={`fuel-swatch seg-${item.key}`}
                        aria-hidden="true"
                      ></span>
                      <span class="fuel-copy">
                        {item.label}
                        <span class="muted">
                          {fmtMw(Number(current[item.key] || 0))} MW
                        </span>
                      </span>
                    </button>
                  </li>
                ))
              }
            </ul>
          </div>
          <p class="hint">Charts below follow this filter.</p>
        </div>
        <div
          id="focus-readout"
          class="focus-readout"
          hidden
          aria-live="polite"
        ></div>
      </section>

      {
        nldcCurrent ? (
          <section class="nldc-strip" aria-labelledby="nldc-strip-label">
            <a class="nldc-strip-link" href="/demand">
              <p id="nldc-strip-label" class="kicker">
                {nldcIsYesterday ? "Yesterday (NLDC)" : "NLDC report"}
              </p>
              <div class="nldc-pair">
                <p class="nldc-stat">
                  <span class="nldc-num">
                    {fmtGwh(nldcCurrent.energy.unserved_gwh)}
                  </span>
                  <span class="nldc-unit">GWh unserved</span>
                </p>
                <p class="nldc-stat">
                  <span class="nldc-num">
                    {fmtMw(nldcCurrent.evening_peak.load_shed_mw || 0)}
                  </span>
                  <span class="nldc-unit">MW evening load-shed</span>
                </p>
              </div>
              <p class="when">
                {fmtDate(nldcCurrent.date)} · daily System Summary, not this
                hour’s generation
              </p>
            </a>
          </section>
        ) : null
      }

      <section aria-labelledby="h48">
        <div class="section-head">
          <h2 id="h48">Last 48 hours</h2>
          <div class="segmented" role="group" aria-label="48-hour chart mode">
            <button type="button" data-hourly="total" aria-pressed="true">
              Total
            </button>
            <button type="button" data-hourly="mix" aria-pressed="false">
              Mix
            </button>
          </div>
        </div>
        <p class="caption" id="caption-hourly">
          Total generation (MW), including the 19:30 evening-peak row when PGCB
          publishes it.
        </p>
        <div class="chart-frame">
          <canvas id="chart-48h"></canvas>
        </div>
        <div class="inspect" id="inspect-hourly" hidden></div>
      </section>

      <section aria-labelledby="h7">
        <div class="section-head">
          <h2 id="h7">Last 7 days</h2>
          <div class="segmented" role="group" aria-label="Units">
            <button type="button" data-unit="mw" aria-pressed="true">MW</button>
            <button type="button" data-unit="share" aria-pressed="false">
              Share
            </button>
          </div>
        </div>
        <p class="caption" id="caption-7d">
          Daily mean mix (MW). Imports are HVDC Bheramara, Tripura, Adani, and
          Nepal combined.
        </p>
        <div class="chart-frame">
          <canvas id="chart-7d"></canvas>
        </div>
        <div class="inspect" id="inspect-7d" hidden></div>
      </section>

      <section aria-labelledby="hmo">
        <div class="section-head">
          <h2 id="hmo">Monthly mix</h2>
          <div class="segmented" role="group" aria-label="Units">
            <button type="button" data-unit="mw" aria-pressed="true">MW</button>
            <button type="button" data-unit="share" aria-pressed="false">
              Share
            </button>
          </div>
        </div>
        <div
          id="month-windows"
          class="chips"
          role="group"
          aria-label="Monthly range"
        ></div>
        <p class="caption" id="caption-monthly">
          Mean generation by fuel, {defaultRange}. Seeded from the public PGCB
          hourly archive; the last month updates as new hours arrive.
        </p>
        <div class="chart-frame">
          <canvas id="chart-monthly"></canvas>
        </div>
        <div class="inspect" id="inspect-monthly" hidden></div>
      </section>
    </main>

    <footer>
      <p>
        Source:{" "}
        <a href={latest.source}>
          {latest.source_name} generation table
        </a>
        . Figures are dispatched generation in MW, Asia/Dhaka, not billed
        consumption. Daily demand and load-shedding are on the{" "}
        <a href="/demand">Demand</a> page, from the NLDC summary.
      </p>
      <p class="muted">
        JSON updated {fmtWhen(latest.updated_at)}.{" "}
        <a href="https://github.com/sunrisesineast/bangladesh-grid">Source code</a>
      </p>
    </footer>

    <script id="grid-data" type="application/json" set:html={JSON.stringify(chartData)} />
    <script>
      import { renderCharts } from "../lib/charts.ts";
      const el = document.getElementById("grid-data");
      if (el?.textContent) renderCharts(JSON.parse(el.textContent));
    </script>
  </body>
</html>
